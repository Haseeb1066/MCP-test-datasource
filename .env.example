# IMPORTANT: Use KEY=value lines only. Do not paste MCP_SERVERS JSON here (see mcp-servers.cursor.example.json).

# workbook = dashboards/sheets only (default).
# datasource = published datasources + query-datasource.
# Extension on a dashboard auto-scopes to that dashboard's datasources (forces datasource tools for those).
TABLEAU_CHAT_MODE=workbook

# OpenAI (required for the chat page)
OPENAI_API_KEY=sk-your-key-here

TABLEAU_SERVER=
# Site "contentUrl" from Tableau (case-sensitive). Must match the site where the Connected App was created.
# TABLEAU_SITE_NAME=
TABLEAU_SITE_NAME=

# --- Preferred: Connected App (direct-trust) — chat runs as each Tableau user ---
# Create under Site Settings → Connected Apps (Direct Trust).
TABLEAU_CONNECTED_APP_CLIENT_ID=
TABLEAU_CONNECTED_APP_SECRET_ID=
TABLEAU_CONNECTED_APP_SECRET=
# Optional default JWT sub for server-side tests (extension still asks each user):
# TABLEAU_JWT_SUB_CLAIM=demoAdmin

# --- Fallback: shared PAT (everyone acts as the PAT user) ---
# Only used when Connected App vars above are empty.
TABLEAU_PAT_NAME=
TABLEAU_PAT_VALUE=

# If you see 401 from /auth/signin: check SITE_NAME, username (demoAdmin vs local\demoAdmin),
# and Connected App enabled on that site. For PAT: regenerate token and match PAT_NAME exactly.

# Optional: MCP client timeouts (ms). SDK default is 60s; Tableau tools often need longer (-32001 if too short).
# MCP_REQUEST_TIMEOUT_MS=900000
# MCP_INIT_TIMEOUT_MS=180000
# MCP_LIST_TOOLS_TIMEOUT_MS=120000

# Tableau MCP: get-datasource-metadata is enabled automatically in datasource/extension mode
# (preferred when Metadata GraphQL returns 403 on Server). To force-disable:
# DISABLE_DATASOURCE_METADATA_TOOL=1
# To force-enable even in workbook mode:
# ENABLE_DATASOURCE_METADATA_TOOL=1

# Optional: extra lines appended to the model system prompt (org-specific metrics / naming)
# CHAT_SYSTEM_EXTRA=Published datasource is named "NOC Performance". After listing fields, use the real date and measure captions in query-datasource (e.g. Report Date, Performance %).

# Optional: self-signed TLS only (insecure; remove in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0
# TABLEAU_SSL_VERIFY=0

# Run: pip install -r requirements.txt && npm install && npm run dev
# UI: http://localhost:5173

# Tableau extension: if API is on a different host than the built UI, set when building:
# VITE_API_BASE=https://api.example.com

# Built-in field lister uses Tableau REST sign-in + Metadata GraphQL (/api/metadata/graphql).
# TABLEAU_REST_API_VERSION=3.27
# DISABLE_LOCAL_DATASOURCE_FIELD_TOOL=1

# Test Connected App: python scripts/test-connected-app.py demoAdmin
# Health: GET /api/health  and  GET /api/auth/verify?tableauUsername=demoAdmin
